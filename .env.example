# Application
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_USE_MOCK_API=false
NEXT_PUBLIC_MOCK_API_ERROR=false
NEXT_PUBLIC_MOCK_EMAIL_ERROR=false
APP_TIMEZONE=Asia/Shanghai

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI
# 推荐国内模型：DeepSeek V4 Pro。真实密钥仅写入被忽略的 .env.local。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_MS=30000
USE_MOCK_AI=false

# News provider
NEWS_API_KEY=
NEWS_API_BASE_URL=
# NewsAPI-compatible domain filter. These domains target the three requested platforms.
NEWS_API_DOMAINS=people.com.cn,toutiao.com,qq.com
NEWS_CACHE_TTL_SECONDS=600
NEWS_PROVIDER_TIMEOUT_MS=8000
# JSON array: [{"name":"官方来源","url":"https://...","category":"科技","language":"zh"}]
NEWS_RSS_SOURCES=
# Comma-separated query list used by the ingestion cron.
NEWS_INGEST_QUERIES=

# Backend
DEMO_USER_ID=demo-user
DEBUG_NEWS_SCORES=false

# Email
RESEND_API_KEY=
EMAIL_FROM=

# Scheduled task authentication
CRON_SECRET=
